# Copy this file to .env.local for local development and fill in the values
# from Firebase Console -> Project settings -> Your apps -> SDK setup and
# configuration ("Config" option). See README.md for step-by-step instructions.
#
# These exact names (including the VITE_ prefix, required by Vite to expose
# them to client code) must also be set as Environment Variables in your
# Vercel project settings for Production/Preview/Development.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
